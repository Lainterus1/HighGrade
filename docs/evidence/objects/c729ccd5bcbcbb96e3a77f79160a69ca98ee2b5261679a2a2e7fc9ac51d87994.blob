{
  "id": "S1",
  "subject": "plugins/svg-vectorizer/scripts/svg_tools.mjs",
  "intended_violation": "Optimization changing a rendered channel by more than 2 must fail and preserve destinations",
  "mutation_diff": "--- svg_tools.mjs\n+++ svg_tools.mjs\n@@ -54,7 +54,7 @@\n   for (let i = 0; i < before.pixels.length; i++) {\n     maxDifference = Math.max(maxDifference, Math.abs(before.pixels[i] - after.pixels[i]));\n   }\n-  if (maxDifference > 2) {\n+  if (false) {\n     fail(`\u041d\u0435\u0432\u0430\u043b\u0438\u0434\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442: SVGO \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u043e\u0442\u0440\u0438\u0441\u043e\u0432\u043a\u0443 (\u0440\u0430\u0437\u043d\u0438\u0446\u0430 \u043a\u0430\u043d\u0430\u043b\u0430 ${maxDifference}/255). \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 --no-optimize.`);\n   }\n   let visible = false;\n",
  "runs": []
}
