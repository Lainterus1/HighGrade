from pathlib import Path
from datetime import datetime,timezone
import json,subprocess
root=Path.cwd();local=root/'.highgrade/local/project-refresh-2026-10-14';cli=str(root/'target/debug/highgrade');junit=json.loads((local/'native-export.json').read_text())['junit'];batch=[]
common=['Cargo.toml','Cargo.lock','rust-toolchain.toml','src/lib.rs','src/paths.rs','tests/support/mod.rs']
model=['src/specs.rs','src/specs/attention.rs','src/specs/cards.rs','src/specs/progress.rs','src/specs/checks.rs','src/specs/storage.rs','src/specs/storage/shared_inputs.rs','src/specs/relations.rs']
def add(ident,scenario,inputs,observation):
 assert all((root/p).is_file() for p in inputs)
 batch.append({'id':ident,'evidence':{'scenario':scenario,'method':'native_report','command':'cargo nextest run --locked --profile highgrade','captured_at':datetime.now(timezone.utc).isoformat(),'outcome':'passed','observation':observation+' Source: original 237-case JUnit, zero skips. This is local Linux evidence, not new-SHA Windows CI, activation or acceptance.','inputs':sorted(set(common+inputs)),'report':junit}})
add('HG-0061','HG-0061-S3',['src/ui.rs','src/ui/bundle.rs','src/main.rs','src/global.rs','src/install.rs','src/package.rs','src/release_notes.rs','src/launcher.rs','build.rs','tests/ui_bundle_contracts.rs','ui/dist/highgrade-ui.json','kit/manifest.json'],
 'Current lib bundle unit rejects omitted resources with consistent remaining hashes, including all delivered Lora copies and Lora OFL. ui_check_is_rootless_read_only_and_rejects_conflicting_options and incompatible_ui_candidate_is_rejected_before_install_or_update_writes passed with actual binary probes and profile byte preservation. R6 guard-removal mutation independently caused the omission assertion to fail; restored selector passed.')
add('HG-0061','HG-0061-S5',model+['tests/attention_contracts.rs'],
 'Actual repeated_requests, repeated_result_requests and repeated_result_responses cases rechecked readiness/input identity, rejected changed revision/payload and preserved exact history/neighboring questions. Equivalent repeats did not add duplicate decisions.')
add('HG-0061','HG-0061-S6',model+['tests/attention_contracts.rs'],
 'legacy_result_responses_require_unambiguous_acceptance_revision actually passed: old response without saved version remains readable, unique equivalent association may repeat, ambiguous/different associations reject, and old history is preserved.')
add('HG-0069','HG-0069-S1',model+['src/specs/delivery.rs','tests/spec_contracts.rs','tests/fixtures/native-v1/store.json'],
 'evidence_cards_are_compact_preserve_outcome_and_detect_changed_report actually asserted failed remains failed, full file maps are absent, changed large report becomes stale, compact JSON remains below 2500 bytes and missing source is reported. No report authenticity or future agent reliability is inferred.')
path=local/'native-extra-evidence.json';path.write_text(json.dumps(batch,ensure_ascii=False,indent=2)+'\n')
listing=json.loads(subprocess.check_output([cli,'spec-list','--root',str(root)]));expected=next(m['store_sha256'] for m in listing['measurements'] if 'store_sha256' in m)
argv=[cli,'spec-evidence-batch','--root',str(root),'--expected',expected,'--input',str(path.relative_to(root))];r=subprocess.run(argv,capture_output=True,text=True)
(local/'native-extra-evidence-receipt.json').write_text(json.dumps({'argv':argv,'exit_code':r.returncode,'stdout':r.stdout,'stderr':r.stderr},ensure_ascii=False,indent=2)+'\n')
print('Additional current records',len(batch),'exit',r.returncode);assert r.returncode==0,r.stdout+r.stderr
