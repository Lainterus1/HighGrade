": \"in_progress\",\n        \"created_at\": 1790840670,\n        \"archived\": true\n      },\n      {\n        \"id\": \"HG-0066\",\n        \"title\": \"Проверка изменяемого поведения до реализации\",\n        \"tags\": [\n          \"verification\",\n          \"workflow\"\n        ],\n        \"goal\": \"Агент High Grade проверяет согласованный исход до изменения реализации там, где это даёт устойчивую автоматическую обратную связь, и сохраняет соразмерность проверок, достоверность доказательств и существующее ревью.\",\n        \"change_sha256\": \"518fc353a427b96cce0939f6d26c13151334778b371adaaf742eb29b8034e295\",\n        \"human\": \"pending\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [\n            {\n              \"id\": \"HG-0021\",\n              \"title\": \"Достаточные проверки и устойчивые доказательства\",\n              \"integrated\": true,\n              \"reason\": \"Дополняет действующее требование HG-0021-R3 порядком ранней проверки, сохраняя достаточность и актуальность результатов.\"\n            },\n            {\n              \"id\": \"HG-0026\",\n              \"title\": \"Достаточные проверки и единые правила процесса\",\n              \"integrated\": true,\n              \"reason\": \"Сохраняет владельца правил Work и отсутствие дополнительных обязательных ролей.\"\n            },\n            {\n              \"id\": \"HG-0043\",\n              \"title\": \"Согласование workflow, доказательств и Fixer к 0.3.0\",\n              \"integrated\": true,\n              \"reason\": \"Проверяет содержание нового правила смысловой сверкой, без объявления будущих действий агента наблюдёнными.\"\n            }\n          ],\n          \"same_requirements\": [\n            {\n              \"id\": \"HG-0021\",\n              \"title\": \"Достаточные проверки и устойчивые доказательства\"\n            },\n            {\n              \"id\": \"HG-0026\",\n              \"title\": \"Достаточные проверки и единые правила процесса\"\n            }\n          ]\n        },\n        \"technical\": \"in_progress\",\n        \"created_at\": 1790866607,\n        \"archived\": true\n      },\n      {\n        \"id\": \"HG-0067\",\n        \"title\": \"Редизайн UI и Storybook в стиле Editorial\",\n        \"tags\": [\n          \"user-interface\"\n        ],\n        \"goal\": \"Оформить существующий UI и Storybook в выбранном стиле Editorial, повысив визуальную иерархию и качество компонентов без изменения информации и поведения.\",\n        \"change_sha256\": \"889dca0efcb4249b4bf9dfae501a503b2f1944538d7d659e4c0af74d8e8cea48\",\n        \"human\": \"pending\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [\n            {\n              \"id\": \"HG-0058\",\n              \"title\": \"Уточнение компактного интерфейса спецификаций и отзывчивости\",\n              \"integrated\": true,\n              \"reason\": \"Сохраняет компактное содержание, операции и поведение; изменяет только визуальные требования.\"\n            },\n            {\n              \"id\": \"HG-0054\",\n              \"title\": \"Визуальная основа HighGrade и оформленный Storybook\",\n              \"integrated\": true,\n              \"reason\": \"Развивает общий визуальный язык и Storybook.\"\n            }\n          ],\n          \"same_requirements\": [\n            {\n              \"id\": \"HG-0054\",\n              \"title\": \"Визуальная основа HighGrade и оформленный Storybook\"\n            },\n            {\n              \"id\": \"HG-0058\",\n              \"title\": \"Уточнение компактного интерфейса спецификаций и отзывчивости\"\n            }\n          ]\n        },\n        \"technical\": \"in_progress\",\n        \"created_at\": 1790910595,\n        \"archived\": false\n      },\n      {\n        \"id\": \"HG-0068\",\n        \"title\": \"Переносимый запуск UI из папки проекта и совместимость Update\",\n        \"tags\": [],\n        \"goal\": \"Открывать локальный UI файлом из корня проекта после Init и обновлений общей установки.\",\n        \"change_sha256\": \"484c8a1856982bf1b1a5f7660c42f23800511a6a10d11ae7d4bcb53657ed21e0\",\n        \"human\": \"pending\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [],\n          \"same_requirements\": []\n        },\n        \"technical\": \"in_progress\",\n        \"created_at\": 1790915871,\n        \"archived\": false\n      },\n      {\n        \"id\": \"HG-0069\",\n        \"title\": \"Компактные доказательства и безопасная очистка рабочих результатов\",\n        \"tags\": [],\n        \"goal\": \"Сократить шум постоянных отчётов и контекста, обеспечить безопасную очистку временных результатов без потери доказательств.\",\n        \"change_sha256\": \"9db581a8e6ccad848b936cceea0aa04d56bf0fb45aec23bd51ca9e2e8e4371dc\",\n        \"human\": \"stale\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [\n            {\n              \"id\": \"HG-0064\",\n              \"title\": \"Общие входы доказательств без потери истории\",\n              \"integrated\": true,\n              \"reason\": \"Переиспользование существующих общих входов\"\n            },\n            {\n              \"id\": \"HG-0065\",\n              \"title\": \"Контроль диска повторных Rust-сборок\",\n              \"integrated\": true,\n              \"reason\": \"Бюджет и безопасность сборочного обслуживания\"\n            }\n          ],\n          \"same_requirements\": []\n        },\n        \"technical\": \"in_progress\",\n        \"created_at\": 1790917034,\n        \"archived\": true\n      },\n      {\n        \"id\": \"HG-0070\",\n        \"title\": \"Простая приёмка результата без ручного SHA\",\n        \"tags\": [\n          \"specifications\",\n          \"user-interface\",\n          \"workflow\"\n        ],\n        \"goal\": \"Принимать локальный проверенный результат сменой статуса без ручного SHA, обязательного имени, комментария и дополнительных вызовов LLM.\",\n        \"change_sha256\": \"3bb6a12bdc0628da7d305b66e3ca5bfb9851614fd8f695946dd8fde94f2eae6a\",\n        \"human\": \"stale\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [\n            {\n              \"id\": \"HG-0052\",\n              \"title\": \"Решения человека и очередь внимания для интерфейса спек\",\n              \"integrated\": true,\n              \"reason\": \"Модель обращений и защита актуальности\"\n            },\n            {\n              \"id\": \"HG-0058\",\n              \"title\": \"Уточнение компактного интерфейса спецификаций и отзывчивости\",\n              \"integrated\": true,\n              \"reason\": \"Меняет действующий состав компактной формы\"\n            },\n            {\n              \"id\": \"HG-0061\",\n              \"title\": \"Устранение разрывов надёжности UI и проверок\",\n              \"integrated\": true,\n              \"reason\": \"Сохраняет восстановление решения и строгие повторы\"\n            }\n          ],\n          \"same_requirements\": [\n            {\n              \"id\": \"HG-0012\",\n              \"title\": \"Нумерация, прогресс и решение человека\"\n            },\n            {\n              \"id\": \"HG-0052\",\n              \"title\": \"Решения человека и очередь внимания для интерфейса спек\"\n            },\n            {\n              \"id\": \"HG-0056\",\n              \"title\": \"Редактирование спецификаций и решения человека в UI\"\n            },\n            {\n              \"id\": \"HG-0058\",\n              \"title\": \"Уточнение компактного интерфейса спецификаций и отзывчивости\"\n            }\n          ]\n        },\n        \"technical\": \"in_progress\",\n        \"created_at\": 1791527329,\n        \"archived\": true\n      },\n      {\n        \"id\": \"HG-0071\",\n        \"title\": \"Правила содержания документации в Поставке\",\n        \"tags\": [\n          \"workflow\"\n        ],\n        \"goal\": \"Дать Поставке единые правила полезного содержания документации с выборочным чтением и сохранением местных соглашений.\",\n        \"change_sha256\": \"ce292f6890454330a0cc08635b07ac4afbde67ef7cbd115a50dd08db247868ec\",\n        \"human\": \"pending\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [],\n          \"same_requirements\": []\n        },\n        \"technical\": \"in_progress\",\n        \"created_at\": 1791795477,\n        \"archived\": true\n      },\n      {\n        \"id\": \"HG-0072\",\n        \"title\": \"Асинхронный CI и достаточная матрица Linux/Windows\",\n        \"tags\": [\n          \"workflow\"\n        ],\n        \"goal\": \"Убрать обязательное ожидание CI и сократить повторные проверки без потери важных гарантий переносимой Поставки.\",\n        \"change_sha256\": \"9a8a27991c38acf7e4f9064d6eb5876a46783a111455e609edb6d94cdb9444cc\",\n        \"human\": \"pending\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [\n            {\n              \"id\": \"HG-0071\",\n              \"title\": \"Правила содержания документации в Поставке\",\n              \"integrated\": true,\n              \"reason\": \"Общая неактивированная цепочка выпуска 0.3.12.\"\n            },\n            {\n              \"id\": \"HG-0063\",\n              \"title\": \"Переносимый Commit и раздельные состояния доставки\",\n              \"integrated\": false,\n              \"reason\": \"Точечно согласованы прежние положения CI; остальная работа не переоткрыта и не закрыта.\"\n            }\n          ],\n          \"same_requirements\": [\n            {\n              \"id\": \"HG-0061\",\n              \"title\": \"Устранение разрывов надёжности UI и проверок\"\n            }\n          ]\n        },\n        \"technical\": \"in_progress\",\n        \"created_at\": 1791797871,\n        \"archived\": true\n      },\n      {\n        \"id\": \"HG-0073\",\n        \"title\": \"Английские инструкции и измеримый контекст\",\n        \"tags\": [\n          \"documentation\",\n          \"workflow\"\n        ],\n        \"goal\": \"Перевести инструкции агента на английский и измерить экономию контекста при сохранении смысла и языка результатов.\",\n        \"change_sha256\": \"3b6962318a20c902fa53a7dde41970457f5a4a03e592daa50d29deddc75fdec8\",\n        \"human\": \"pending\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [\n            {\n              \"id\": \"HG-0010\",\n              \"title\": \"Самостоятельная Поставка и адаптация\",\n              \"integrated\": true,\n              \"reason\": \"Самостоятельность установленного контекста и единый источник навыков.\"\n            },\n            {\n              \"id\": \"HG-0071\",\n              \"title\": \"Правила содержания документации в Поставке\",\n              \"integrated\": true,\n              \"reason\": \"Выборочное чтение документации и местные соглашения.\"\n            }\n          ],\n          \"same_requirements\": []\n        },\n        \"technical\": \"in_progress\",\n        \"created_at\": 1791880020,\n        \"archived\": true\n      },\n      {\n        \"id\": \"HG-0074\",\n        \"title\": \"Пользовательская сводка обновления и сопровождение README\",\n        \"tags\": [\n          \"installation\",\n          \"workflow\"\n        ],\n        \"goal\": \"Показать компактную проверяемую сводку Update и поддерживать README по значимым возможностям.\",\n        \"change_sha256\": \"7eac9e6d9cf05db9bbb817c191daf8060de3817539fefacc652d008466ee7c2d\",\n        \"human\": \"pending\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [\n            {\n              \"id\": \"HG-0010\",\n              \"title\": \"Самостоятельная Поставка и адаптация\",\n              \"integrated\": true,\n              \"reason\": \"Автономный проверяемый состав Поставки.\"\n            },\n            {\n              \"id\": \"HG-0011\",\n              \"title\": \"Принятие, публикация и обновление\",\n              \"integrated\": true,\n              \"reason\": \"Границы Update и раздельные состояния доставки.\"\n            },\n            {\n              \"id\": \"HG-0073\",\n              \"title\": \"Английские инструкции и измеримый контекст\",\n              \"integrated\": true,\n              \"reason\": \"Общий итоговый набор инструкций; порядок не требует зависимости интеграции.\"\n            }\n          ],\n          \"same_requirements\": []\n        },\n        \"technical\": \"in_progress\",\n        \"created_at\": 1791880022,\n        \"archived\": true\n      },\n      {\n        \"id\": \"HG-0075\",\n        \"title\": \"Поэтапная актуализация документации и тестов через Clear\",\n        \"tags\": [\n          \"verification\",\n          \"workflow\"\n        ],\n        \"goal\": \"Сделать highgrade-clear воспроизводимой поэтапной актуализацией выбранной области документации и тестов, с обязательным Planner, содержательными проверками и явным остатком.\",\n        \"change_sha256\": \"5be80f87248483c45a3767df95595439a17a255fa28fddfc33979ad953ed812a\",\n        \"human\": \"pending\",\n        \"links\": {\n          \"depends_on\": [],\n          \"related_to\": [\n            {\n              \"id\": \"HG-0020\",\n              \"title\": \"Highgrade Planner и поэтапный Goal\",\n              \"integrated\": true,\n              \"reason\": \"Использует существующий Planner и единое продолжение без расширения оснований Goal.\"\n            },\n            {\n              \"id\": \"HG-0043\",\n              \"title\": \"Согласование workflow, доказательств и Fixer к 0.3.0\",\n              \"integrated\": true,\n              \"reason\": \"Сохраняет владельцев знаний, исходные доказательства и проверку существующего Fixer.\"\n            },\n            {\n              \"id\": \"HG-0066\",\n              \"title\": \"Проверка изменяемого поведения до реализации\",\n              \"integrated\": true,\n              \"reason\": \"Дополняет проверку смысла тестов только для явно выбранной актуализации тестов.\"\n            },\n            {\n              \"id\": \"HG-0071\",\n              \"title\": \"Правила содержания документации в Поставке\",\n              \"integrated\": true,\n              \"reason\": \"Использует единые правила содержания документации вместо их повторного владельца.\"\n            }\n          ],\n          \"same_requirements\": []\n        },\n        \"technical\": \"ready\",\n        \"created_at\": 1791898583,\n        \"archived\": true\n      }\n    ],\n    \"origins\": {},\n    \"requirements\": [\n      \"HG-0002-R1\",\n      \"HG-0002-R2\",\n      \"HG-0002-R3\",\n      \"HG-0003-R1\",\n      \"HG-0003-R2\",\n      \"HG-0003-R3\",\n      \"HG-0004-R1\",\n      \"HG-0004-R2\",\n      \"HG-0004-R3\",\n      \"HG-0006-R1\",\n      \"HG-0006-R2\",\n      \"HG-0006-R3\",\n      \"HG-0008-R1\",\n      \"HG-0009-R1\",\n      \"HG-0009-R2\",\n      \"HG-0009-R3\",\n      \"HG-0009-R4\",\n      \"HG-0009-R5\",\n      \"HG-0009-R6\",\n      \"HG-0009-R7\",\n      \"HG-0009-R8\",\n      \"HG-0010-R1\",\n      \"HG-0010-R2\",\n      \"HG-0010-R3\",\n      \"HG-0010-R4\",\n      \"HG-0010-R5\",\n      \"HG-0010-R6\",\n      \"HG-0010-R7\",\n      \"HG-0010-R8\",\n      \"HG-0010-R9\",\n      \"HG-0011-R1\",\n      \"HG-0011-R2\",\n      \"HG-0011-R3\",\n      \"HG-0011-R4\",\n      \"HG-0011-R5\",\n      \"HG-0012-R1\",\n      \"HG-0012-R2\",\n      \"HG-0012-R3\",\n      \"HG-0012-R4\",\n      \"HG-0012-R5\",\n      \"HG-0013-R1\",\n      \"HG-0013-R2\",\n      \"HG-0013-R3\",\n      \"HG-0013-R4\",\n      \"HG-0014-R1\",\n      \"HG-0015-R1\",\n      \"HG-0016-R1\",\n      \"HG-0017-R1\",\n      \"HG-0018-R1\",\n      \"HG-0018-R2\",\n      \"HG-0019-R1\",\n      \"HG-0019-R2\",\n      \"HG-0020-R1\",\n      \"HG-0020-R2\",\n      \"HG-0020-R3\",\n      \"HG-0020-R4\",\n      \"HG