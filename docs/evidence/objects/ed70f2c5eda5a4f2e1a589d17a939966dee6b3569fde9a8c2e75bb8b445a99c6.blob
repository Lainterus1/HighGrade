    {
      "change": {
        "id": "HG-0003",
        "title": "Связи, теги и выборочный контекст",
        "tags": [
          "specifications"
        ],
        "goal": "Связи, теги и выборочный контекст",
        "rationale": "Согласованная переработка по запросу автора: переносимость проектных данных, удобный контекст и проверки без лишней сложности.",
        "scope": "CLI, процедуры Поставки, шаблоны, документация и изолированные проверки; без публикации, глобальной активации, UI, наследования и изменения OpenSpec/других проектов.",
        "questions": [],
        "depends_on": [
          {
            "id": "HG-0002",
            "reason": "Используется каталог и метаданные предыдущего этапа"
          }
        ],
        "operations": [
          {
            "action": "add",
            "requirement": {
              "id": "HG-0003-R1",
              "title": "Связи без наследования",
              "statement": "depends_on и related_to содержат ID и причину; зависимости проверяются на существование и циклы. Наследования полей нет; цепочка контекста не разворачивается автоматически.",
              "scenarios": [
                {
                  "id": "HG-0003-S1",
                  "given": "Несколько спек и действующие требования",
                  "when": "Связать их, затем передать цикл или неизвестный ID",
                  "then": "Допустимые связи доступны, ошибочные отвергнуты без записи; зависимость влияет на готовность, related_to её не блокирует",
                  "verification": "Изолированный тест настоящего CLI/файловой системы/процесса; воспроизвести подготовку, действие и исход. Для процедур — независимое ревью и сквозной маршрут."
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0003-R2",
              "title": "Плоские теги",
              "statement": "Реестр тегов хранит устойчивый ID, название и назначение. Спеки используют ID; удаление используемого тега запрещено, объединение обновляет ссылки атомарно.",
              "scenarios": [
                {
                  "id": "HG-0003-S2",
                  "given": "Реестр областей и спеки с тегами",
                  "when": "Создать/использовать тег, объединить синонимы, передать неизвестный тег",
                  "then": "Ссылки согласованы, теги не дублируют статусы и не требуют иерархии",
                  "verification": "Изолированный тест настоящего CLI/файловой системы/процесса; воспроизвести подготовку, действие и исход. Для процедур — независимое ревью и сквозной маршрут."
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0003-R3",
              "title": "JSON-сводка",
              "statement": "spec-list вычисляет JSON со статусами, тегами, связями и фильтрами; фильтр показывает отобранное и общий объём, а зависимости остаются обнаружимыми без загрузки полных соседних спек.",
              "scenarios": [
                {
                  "id": "HG-0003-S3",
                  "given": "Смешанный каталог с готовыми и незавершёнными спеками разных областей",
                  "when": "Отфильтровать по тегу и статусу",
                  "then": "Возвращён верный набор и количества; краткие связи сохранены, неизвестные фильтры не выдают ложный успех",
                  "verification": "Изолированный тест настоящего CLI/файловой системы/процесса; воспроизвести подготовку, действие и исход. Для процедур — независимое ревью и сквозной маршрут."
                }
              ]
            }
          }
        ],
