    {
      "change": {
        "id": "HG-0011",
        "title": "Принятие, публикация и обновление",
        "tags": [
          "installation",
          "workflow"
        ],
        "goal": "Действующие требования области «Принятие, публикация и обновление» доступны в самостоятельном нативном формате с конкретными сценариями и честным статусом проверки",
        "rationale": "Актуализация действующего контракта по аудиту завершённых правил; отсутствие проверки не считается успехом",
        "scope": "Действующее поведение области «Принятие, публикация и обновление»; старые источники и решения остаются только в архиве",
        "questions": [],
        "operations": [
          {
            "action": "add",
            "requirement": {
              "id": "HG-0011-R1",
              "title": "Локальное принятие задачи",
              "statement": "High Grade SHALL предоставлять `highgrade-approve` для проверенного локального завершения конкретной задачи после `work`. Вызов SHALL разрешать отбор, проверку доказательств и состава, завершение предусмотренного проектом изменения требований, если оно есть, и локальный коммит, но SHALL NOT разрешать push, PR, тег или эксплуатационное развёртывание. Если проектная инструкция определяет местную активацию как часть принятия, тот же вызов MAY разрешать её только из зафиксированного SHA и с проверкой результата. При сбое активации инструмент SHALL сохранять коммит, сообщать наблюдаемое состояние и результат доступной процедуры восстановления; он SHALL NOT утверждать, что прежний выпуск исправен, без проверки. Отсутствие местного маршрута активации SHALL NOT мешать ясному коммиту. Посторонние изменения SHALL оставаться вне коммита.",
              "scenarios": [
                {
                  "id": "HG-0011-S1",
                  "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: задача проверена, а проект не задаёт местный маршрут активации",
                  "when": "Выполнить highgrade-approve по заданной области и сохранить его фактические действия",
                  "then": "approve создаёт коммит и сообщает SHA без выдуманной команды активации",
                  "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
                },
                {
                  "id": "HG-0011-S2",
                  "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: коммит создан, но назначенная проектом активация из его SHA не прошла",
                  "when": "Выполнить highgrade-approve по заданной области и сохранить его фактические действия",
                  "then": "коммит сохраняется, задача не объявляется полностью активной, а отчёт указывает ошибку, наблюдаемое состояние прежнего выпуска и результат доступного восстановления без неподтверждённых гарантий",
                  "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0011-R2",
              "title": "Отбор состава при локальном принятии",
              "statement": "`highgrade-approve` SHALL включать только проверенный состав задачи и проверять полный staged diff. Доказательства и ревью из work SHALL использоваться повторно, если исходный состав и значимые зависимости не изменились; только изменение или пробел требует новой проверки. Одноразовые результаты SHALL удаляться после сверки принадлежности и ссылок, а значимые доказательства SHALL иметь одно основное место.",
              "scenarios": [
                {
                  "id": "HG-0011-S3",
                  "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: после work состав, тесты и значимые зависимости не изменились",
                  "when": "Выполнить highgrade-approve по заданной области и сохранить его фактические действия",
                  "then": "approve сверяет запись и staged diff без повторного полного запуска уже успешных проверок",
                  "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
                },
                {
                  "id": "HG-0011-S4",
                  "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: рядом с принятой задачей лежат посторонние и неоднозначные изменения",
                  "when": "Выполнить highgrade-approve по заданной области и сохранить его фактические действия",
                  "then": "approve коммитит только принятый состав и сохраняет остальные изменения",
                  "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0011-R3",
              "title": "Публикация проверенного диапазона",
              "statement": "`highgrade-push` SHALL отправлять явно выбранный непрерывный диапазон готовых коммитов после проверки удалённой цели, состава диапазона и внешних последствий. Подтверждённые ранее локальные проверки SHALL не повторяться без изменения исходника, зависимостей или найденного риска. После push SHALL проверяться удалённый SHA и фактически доступный результат CI.",
              "scenarios": [
                {
                  "id": "HG-0011-S5",
                  "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: готовый коммит уже проверен и не изменился",
                  "when": "Выполнить highgrade-push по заданной области и сохранить его фактические действия",
                  "then": "push проверяет границы, удалённую ветку и последствия, но не повторяет полный локальный набор тестов",
                  "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
                },
                {
                  "id": "HG-0011-S6",
                  "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: автор поручает отправить проверенный диапазон с несколькими локально принятыми задачами",
                  "when": "Выполнить highgrade-push по заданной области и сохранить его фактические действия",
                  "then": "push сверяет все коммиты и цель, отправляет диапазон и проверяет итоговый удалённый SHA",
                  "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
                },
                {
                  "id": "HG-0011-S7",
                  "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: выбранный диапазон содержит коммит без доказанной принадлежности пакету",
                  "when": "Выполнить highgrade-push по заданной области и сохранить его фактические действия",
                  "then": "агент не отправляет диапазон и показывает конкретный коммит для решения",
                  "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
                },
                {
                  "id": "HG-0011-S8",
                  "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: runbook указывает, что отправка запустит эксплуатационную активацию",
                  "when": "Выполнить highgrade-push по заданной области и сохранить его фактические действия",
                  "then": "агент раскрывает следствие до отправки и действует только при разрешении на это следствие",
                  "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0011-R4",
              "title": "Безопасное обновление и очистка прежнего выпуска",
              "statement": "`global-update` SHALL проверять кандидат до смены активного указателя и после неё. До успешного окончания postcheck прежний выпуск SHALL оставаться пригодным для автоматического восстановления при ошибке. После успеха CLI SHALL удалять принадлежащие ему файлы неактивных выпусков и SHALL сохранять чужие файлы с явным предупреждением. Команда выбора прежнего выпуска для постоянного отката SHALL отсутствовать. Прерывание SHALL оставлять проверяемый активный журнал; неактивные маршрутизаторы SHALL не давать полномочий.",
              "scenarios": [
                {
                  "id": "HG-0011-S9",
                  "given": "В изолированном профиле установлен прежний выпуск и подготовлен валидный кандидат с другим release ID",
                  "when": "Выполнить preview и применение global-update по одному отпечатку кандидата",
                  "then": "новый выпуск активен после postcheck, собственные файлы прежнего выпуска очищены, чужие файлы сохранены",
                  "verification": "Запустить cargo test --locked --test global_contracts global_update_preview_switch_and_cleanup_keep_unrelated_files -- --exact; проверить фактические утверждения о результате и границах сценария"
                },
                {
                  "id": "HG-0011-S10",
                  "given": "Временная фикстура теста tests/global_contracts.rs::update_preserves_foreign_file_in_old_release создана с исходными данными указанного случая",
                  "when": "после успешного переключения в каталоге прежнего выпуска есть неизвестный файл",
                  "then": "CLI удаляет только проверенные собственные файлы, сохраняет чужой файл и журнал для повторной очистки, сообщает ограничение; после удаления чужого файла следующее обновление завершает очистку",
                  "verification": "Запустить cargo test --locked --test global_contracts update_preserves_foreign_file_in_old_release -- --exact; проверить фактические утверждения о результате и границах сценария"
                }
              ]
            }
