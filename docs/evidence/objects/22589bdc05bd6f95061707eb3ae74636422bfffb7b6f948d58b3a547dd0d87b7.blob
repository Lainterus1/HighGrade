416a16e7e8bf35ea07c866f7dcc06d555911408273fcbca127df2532b.blob\",\n                \"scenario\": \"HG-0024-S4\",\n                \"scenario_sha256\": \"0e5fbf2c09dfbeb879f918bf142701b4142578c97c1a99fedc4e9f9f52263e61\"\n              }\n            },\n            \"review\": {\n              \"change_sha256\": \"24ef3fdba1036ff905cae2540face00f146ed8944532479aa0f1bee4dc6b27ca\",\n              \"conclusion\": \"Независимое ревью GO: три найденные неоднозначности исправлены; адресные тесты, интегрированный Nextest 124/124, trace 48/48, нулевой прирост temp и обновлённые доказательства проверены. RAII не покрывает kill/abort.\",\n              \"reviewer\": \"subagent-hg0024_review\",\n              \"verdict\": \"go\"\n            }\n          }\n        ]\n      },\n      \"change_sha256\": \"7060dc4cc7af071c820a42fca6040e533e4d1a49253193d1c69c80cedd4a97bd\",\n      \"inputs_sha256\": \"88f28f5bf4670558ac80c7cc3fc877f343fa7cd4de6eb765bd2d8b11669dcf85\",\n      \"links\": {\n        \"depends_on\": [],\n        \"related_to\": [],\n        \"same_requirements\": []\n      }\n    }\n  ],\n  \"operation\": \"spec-review\",\n  \"result\": {\n    \"change\": {\n      \"id\": \"HG-0024\",\n      \"title\": \"Честный учёт проверок и ресурсов тестов\",\n      \"tags\": [\n        \"verification\"\n      ],\n      \"goal\": \"Показывать точный охват автоматических проверок и выполнять проектные Rust-тесты без накопления временных файлов и лишних повторов.\",\n      \"rationale\": \"Текущий trace называет отсутствие автоматической связи ScenarioUnconfirmed даже при отдельном доказательстве; счётчики тестов и сценариев смешиваются. Прогон оставляет около 130 МиБ временных файлов; устаревшие результаты требуют адресного разбора.\",\n      \"scope\": \"Отчёты trace и проектной сверки сценариев, тестовые временные фикстуры и документация запуска. Сохранить независимые ручные доказательства, прежние контракты и исторические результаты.\",\n      \"questions\": [],\n      \"operations\": [\n        {\n          \"action\": \"add\",\n          \"requirement\": {\n            \"id\": \"HG-0024-R1\",\n            \"title\": \"Явная область отчёта о проверках\",\n            \"statement\": \"Отчёт автоматической трассировки SHALL раздельно показывать число случаев в исходном отчёте, отдельно число реально выполненных, пропущенных и неизвестных среди записанных в отчёте тестов, а также число отсутствующих результатов при наличии инвентаря (иначе неизвестно), число уникальных тестов с привязкой и результат связанных сценариев. Сценарий без автоматической связи SHALL обозначаться как находящийся вне области этого отчёта; его ручное или внешнее доказательство не SHALL выводиться из трассировки. Сбой, пропуск, неизвестный или устаревший результат связанного теста SHALL оставаться неподтверждённым. Чтение отчёта SHALL не запускать тесты и не менять каталог.\",\n            \"scenarios\": [\n              {\n                \"id\": \"HG-0024-S1\",\n                \"given\": \"Набор содержит несколько тестов, одну связь с несколькими сценариями и тесты без сценарной метки\",\n                \"when\": \"Построить отчёт после фактического запуска\",\n                \"then\": \"Отдельные счётчики случаев в отчёте, выполненных, пропущенных, неизвестных и отсутствующих тестов, уникальных связанных тестов и сценариев точны и не трактуются как один знаменатель\",\n                \"verification\": \"Rust-тест trace на изолированном отчёте Nextest и проверка проектной сводки по настоящему прогону\"\n              },\n              {\n                \"id\": \"HG-0024-S2\",\n                \"given\": \"В каталоге есть сценарий с ручной проверкой или отдельным внешним доказательством без автоматической связи\",\n                \"when\": \"Прочитать автоматическую трассировку\",\n                \"then\": \"Сценарий явно находится вне автоматической области; отчёт не называет его проваленным или проверенным и не подменяет отдельное доказательство\",\n                \"verification\": \"Rust-тест trace с несвязанным сценарием и сохранённым отдельным доказательством\"\n              },\n              {\n                \"id\": \"HG-0024-S3\",\n                \"given\": \"Связанный тест завершился ошибкой, пропущен либо исходный отчёт устарел\",\n                \"when\": \"Прочитать трассировку\",\n                \"then\": \"Связанный сценарий не получает PASS; причина остаётся различимой, а другие результаты не скрывают сбой\",\n                \"verification\": \"Rust-тесты trace для failed, skipped и stale по настоящей структуре отчёта\"\n              }\n            ]\n          }\n        },\n        {\n          \"action\": \"add\",\n          \"requirement\": {\n            \"id\": \"HG-0024-R2\",\n            \"title\": \"Ограниченный жизненный цикл тестовых файлов\",\n            \"statement\": \"Проектные Rust-тесты SHALL изолировать временные каталоги и освобождать собственные результаты после завершения, включая ошибочный тест, без удаления чужих файлов. Очистка ранее накопленных каталогов SHALL предваряться проверкой точного расположения и владения; сомнительные данные сохраняются.\",\n            \"scenarios\": [\n              {\n                \"id\": \"HG-0024-S4\",\n                \"given\": \"Тест создаёт изолированный временный профиль и завершается успешно либо с ошибкой\",\n                \"when\": \"Завершить тестовый процесс\",\n                \"then\": \"Собственный временный профиль удалён, а посторонний каталог и диагностика исхода не затронуты\",\n                \"verification\": \"Регрессионный тест фикстуры и сравнение созданных тестовых каталогов до и после полного Nextest-прогона\"\n              }\n            ]\n          }\n        }\n      ],\n      \"tasks\": [\n        {\n          \"id\": \"HG-0024-T1\",\n          \"description\": \"Сделать честные раздельные статусы trace и проектной сводки; сверить 10 сценариев без check и 74 теста без метки, не добавляя фиктивных связей.\",\n          \"done\": true\n        },\n        {\n          \"id\": \"HG-0024-T2\",\n          \"description\": \"Устранить утечки временных фикстур в тестах, сохранить диагностику и убрать зависимость текущих ожиданий от жёстко заданного номера выпуска.\",\n          \"done\": true\n        },\n        {\n          \"id\": \"HG-0024-T3\",\n          \"description\": \"Классифицировать устаревшие доказательства, измерить время и прирост диска; безопасно разобрать ранее накопленные test-owned каталоги после preview.\",\n          \"done\": true\n        },\n        {\n          \"id\": \"HG-0024-T4\",\n          \"description\": \"Выполнить адресные и полные проверки, записать доказательства, пройти независимое ревью и подготовить локальное принятие.\",\n          \"done\": true\n        }\n      ],\n      \"checks\": [\n        {\n          \"id\": \"HG-0024-C1\",\n          \"action\": \"Запустить тест и прочитать trace\",\n          \"file\": \"tests/trace_contracts.rs\",\n          \"inputs\": [\n            \"scripts/source-scenarios.mjs\",\n            \"src/trace.rs\",\n            \"tests/support/mod.rs\",\n            \"tests/trace_contracts.rs\"\n          ],\n          \"observation\": \"Счётчики согласованы, несвязанное вне автоматической области, сбой и пропуск не становятся PASS\",\n          \"preparation\": \"Изолированный каталог с несколькими Rust-тестами, ручным сценарием и отчётами с разными исходами\",\n          \"runner\": \"rust-contracts\",\n          \"scenario_ids\": [\n            \"HG-0024-S1\",\n            \"HG-0024-S2\",\n            \"HG-0024-S3\"\n          ],\n          \"selector\": \"automatic_trace_keeps_scope_and_outcomes_distinct\"\n        },\n        {\n          \"id\": \"HG-0024-C2\",\n          \"action\": \"Выполнить полный Nextest и пробу ошибочного завершения фикстуры\",\n          \"file\": \"\",\n          \"inputs\": [\n            \"tests/bootstrap_contracts.rs\",\n            \"tests/catalog_contracts.rs\",\n            \"tests/contracts.rs\",\n            \"tests/global_contracts.rs\",\n            \"tests/package_contracts.rs\",\n            \"tests/spec_contracts.rs\",\n            \"tests/support/mod.rs\",\n            \"tests/temp_contracts.rs\",\n            \"tests/trace_contracts.rs\"\n          ],\n          \"observation\": \"Новые test-owned каталоги очищены; чужой каталог сохранён, исход ошибки доступен\",\n          \"preparation\": \"Зафиксировать test-owned каталоги и отдельный посторонний каталог перед прогоном\",\n          \"runner\": null,\n          \"scenario_ids\": [\n            \"HG-0024-S4\"\n          ],\n          \"selector\": \"\"\n        }\n      ],\n      \"imports\": {},\n      \"baseline\": {\n        \"HG-0002-R1\": \"dc22b00bf97392f220b242f7d3932361e9cdc63da955ac4ea64c4cfec91b7d87\",\n        \"HG-0002-R2\": \"e663fd3fd1f74dabfb58e12191419dc948fbe7a269edc60cc028fcd22846dedd\",\n        \"HG-0002-R3\": \"6b92972596cac41e0004257e3e5e5b99c3ef1ff354f83978c11c2cc9c4835b85\",\n        \"HG-0003-R1\": \"258b5f4c1f7107b8c4bc88703efb745d1e07494a1b767de6a3b97a47783c214e\",\n        \"HG-0003-R2\": \"59a1062cc641d74f353b6241139cc451dc24bdf0ccc80dd1077a25a122afd36c\",\n        \"HG-0003-R3\": \"f11155cc8c3a57756ce092d849c95b48eb54f0604f819ad99cd6fbf8e2e31040\",\n        \"HG-0004-R1\": \"50b13757cc692b0b42f6c0118277c5b7a17abd8e0762fa82c3fc27892d620f26\",\n        \"HG-0004-R2\": \"f524789dc69c3fe3297a14a33d44073b5a919b0b31b0ff6375414fc335ee019b\",\n        \"HG-0004-R3\": \"a664ea560c8cb0d975d6bbbb40d9f6ad8811f8372d681050e7bc591901a34c0f\",\n        \"HG-0006-R1\": \"e138f0a93eeb51dd5f103f334ba4917390e7b59b3921a7383cae8f758c1388b4\",\n        \"HG-0006-R2\": \"72a8fc2a075072dd6337b97b55baa29295a9c11b951b5ae3b0169dd2915d4ace\",\n        \"HG-0006-R3\": \"c39b37a0d6b25dbd57928463b30b610114c405015cd673cafa4af980311c491e\",\n        \"HG-0008-R1\": \"a14c81732a18a0d999fdd612d4edf85edd7112d1c226c410ab5e134f37a7fc26\",\n        \"HG-0009-R1\": \"75e0db73f