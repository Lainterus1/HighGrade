  "findings": [
    {
      "id": "UI-F1",
      "severity": "blocking confirmed defect",
      "requirement": "HG-0055-R4",
      "observation": "Real native poll repro RED: B request starts only after releasing obsolete background A",
      "fix": "Cancel obsolete poll reads and suppress their cancellation errors, preserving serialized non-retried writes; same repro GREEN",
      "originals": "poll-repro-red/"
    },
    {
      "id": "UI-F2",
      "severity": "mandatory method gap",
      "requirement": "HG-0053-R1",
      "scenario": "HG-0053-S2",
      "observation": "Existing tagged test disables browser opening and discards stderr",
      "fix": "Actual isolated Unix opener spawn-error with PATH empty, stderr reason+URL, HTTP alive+shutdown+unchanged files; Windows separately"
    },
    {
      "id": "UI-F3",
      "severity": "test strength gap",
      "requirement": "HG-0053-R2",
      "scenario": "HG-0053-S3",
      "observation": "Control file inside root is not the sibling targeted by traversal; no error-body token assertion",
      "fix": "Real sibling sentinel outside root, token hygiene and exact bytes after each refusal"
    },
    {
      "id": "UI-F4",
      "severity": "test strength gap",
      "requirement": "HG-0055-R1",
      "scenario": "HG-0055-S1",
      "observation": "UI test name mentions counters; .count values never asserted",
      "fix": "Assert exact projected numbers/visible rows for all categories, cancel/excluded/history"
    },
    {
      "id": "UI-F5",
      "severity": "normative link drift",
      "requirement": "HG-0054-R5",
      "observation": "Current contract points to missing docs/plans path; historical owner now docs/archive/plans",
      "fix": "Separate scoped Spec modify link; preserve original historical pause and acceptance history"
    },
    {
      "id": "UI-F6",
      "severity": "pending evidence stale/unknown",
      "requirement": "HG-0054-R1/R3/R6",
      "observation": "Lora is already pending HG67; all7 evidence unknown with material changed inputs",
      "fix": "Fresh local required observations and independent scoped GO under existing HG67; do not ask design again"
    },
    {
      "id": "UI-F7",
      "severity": "external criterion open",
      "requirement": "HG-0061-R2 and HG-0068-R1/R2/R3",
      "observation": "Methods name current exact-SHA Linux/Windows installedE2E/launcher; local old candidate or Unix run insufficient",
      "fix": "Show scoped local result and explicit external remainder; no publication/activation authority inferred"
    },
    {
      "id": "UI-F8",
      "severity": "selected optional negative coverage",
      "requirement": "HG-0052-R1/R5",
      "observation": "Structural/profile test checks number not older current exact IDs; queue date ordering lacks controlled distinct timestamps",
      "fix": "Use exact mixed-age/accepted fixture and same-kind distinct at + ID table when assessing these specific risks"
    }
  ],
