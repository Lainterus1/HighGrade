  "operation": "spec-run",
  "result": {
    "change": {
      "id": "HG-0008",
      "title": "Перенос проверенного контракта без ложного PASS",
      "tags": [
        "specifications",
        "verification"
      ],
      "goal": "Перенести ранее действующий контракт из сохранённого источника в нативный каталог без выдуманных доказательств его исполнения",
      "rationale": "Обычный spec-integrate требует нового PASS по каждому сценарию; для сохранения прежнего контракта нужен отдельный проверенный переход, который не приравнивается к технической готовности",
      "scope": "CLI spec-transfer, процедуры Поставки, документация и изолированные проверки; только импортированные add-изменения, без изменения обычного spec-integrate и человеческих решений",
      "questions": [],
      "operations": [
        {
          "action": "add",
          "requirement": {
            "id": "HG-0008-R1",
            "title": "Перенос действующего исторического контракта",
            "statement": "CLI SHALL предоставлять явный перенос выбранного импортированного требования в нативный каталог без объявления поведения проверенным. Перенос SHALL допускать только add-изменение с точным исходным путём и хешем, сохранёнными ID сценариев, завершёнными задачами переноса и свежим независимым GO. Он SHALL атомарно сохранить требование и происхождение; отсутствие сценарного доказательства SHALL оставлять техническую готовность и человеческое решение неподтверждёнными. Обычный spec-integrate SHALL по-прежнему требовать доказательства сценариев. После переноса `trace` SHALL считать нативное требование единственным владельцем его ID; другие прежние требования того же исходного файла SHALL оставаться доступными.",
            "scenarios": [
              {
                "id": "HG-0008-S1",
                "given": "Выборочный импорт с неизменным источником, завершённой сверкой и свежим GO; сценарные доказательства отсутствуют",
                "when": "Вызвать явный перенос по ожидаемому хешу каталога",
                "then": "Требование читается по ID, происхождение закреплено, исходный файл неизменен; изменение остаётся технически in_progress и без человеческой приёмки",
