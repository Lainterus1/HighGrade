    {
      "change": {
        "id": "HG-0022",
        "title": "Однопроходное завершение задач High Grade",
        "tags": [
          "verification",
          "workflow"
        ],
        "goal": "High Grade передаёт актуальный проверенный результат между этапами без повторной работы и показывает точную причину, если затронутая часть требует перепроверки.",
        "rationale": "HG-0011, HG-0020 и HG-0021 уже требуют переиспользовать проверки и вести один Goal, но общий статус spec-check не объясняет, какой вход сделал результат устаревшим, а полное чтение change перед каждым этапом переносит большой журнал истории.",
        "scope": "Краткий read-only вывод spec-check для существующего нативного каталога; процедуры переходов и локального завершения. Без пилота на независимом проекте, автоматической приёмки, push и ослабления барьеров.",
        "questions": [],
        "operations": [
          {
            "action": "add",
            "requirement": {
              "id": "HG-0022-R1",
              "title": "Адресная причина повторной проверки",
              "statement": "При проверке нативного change High Grade SHALL показывать, какие именно сценарии, проверки или ревью требуют повторного действия и почему: отсутствующий результат, непрошедший исход, изменившееся определение либо недоступный или изменившийся проверенный вход. Неизменённые результаты SHALL оставаться действительными; вывод причины SHALL NOT запускать проверку или изменять каталог.",
              "scenarios": [
                {
                  "id": "HG-0022-S1",
                  "given": "Два сценария имеют успешные доказательства с разными исходными файлами.",
                  "when": "Меняется файл, заявленный входом только первого сценария, и вызывается краткая проверка.",
                  "then": "Вывод называет первый сценарий и изменённый путь; второй не отмечается устаревшим, каталог не меняется.",
                  "verification": "Изолированный Rust-контракт создаёт change, записывает оба доказательства, меняет один вход и сравнивает вывод и байты каталога."
                },
                {
                  "id": "HG-0022-S2",
                  "given": "Готовый change с актуальными доказательствами; служебный файл статуса не входит в их заявленные входы.",
                  "when": "Меняется только этот служебный файл и повторяется краткая проверка.",
                  "then": "Доказательства и техническая готовность остаются действительными без нового прогона.",
                  "verification": "Изолированный Rust-контракт меняет только незаявленный файл и сравнивает статус и записи доказательств."
                },
                {
                  "id": "HG-0022-S3",
                  "given": "Автоматическая проверка ранее прошла и хранит отпечатки файла теста и отчёта.",
                  "when": "Изменяется один из её проверенных входов и вызывается краткая проверка.",
                  "then": "Вывод называет ID проверки и изменённый путь, не выдавая старый прогон за действующий.",
                  "verification": "Изолированный Rust-контракт создаёт успешный run, меняет вход и проверяет причину устаревания."
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0022-R2",
              "title": "Краткая передача проверенного состояния",
              "statement": "High Grade SHALL предоставлять краткий read-only снимок из основного каталога для перехода между work, approve и push: технический и человеческий статус, точные отпечатки change и заявленных входов, состояние ревью и причины неподтверждённой готовности. Снимок SHALL сохранять различие между технической готовностью и решением человека, не копировать полный журнал и не создавать второй отчёт.",
              "scenarios": [
                {
                  "id": "HG-0022-S4",
                  "given": "Change готов, ревью актуально, а решение человека записано для его текущей редакции.",
                  "when": "Агент запрашивает краткий снимок дважды без изменения входов.",
                  "then": "Оба вывода дают одинаковые статусы и отпечатки, не содержат полного change/history и не изменяют каталог.",
                  "verification": "Изолированный Rust-контракт сравнивает снимок с spec-read и spec-list и проверяет неизменность файлов каталога."
                }
              ]
            }
          }
        ],
        "tasks": [
          {
            "id": "HG-0022-T1",
            "description": "Добавить краткую диагностику spec-check и компактный снимок для передачи между этапами без нового файла",
            "done": true
          },
          {
