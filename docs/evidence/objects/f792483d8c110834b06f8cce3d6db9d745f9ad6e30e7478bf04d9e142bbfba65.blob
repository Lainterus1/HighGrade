  "result": {
    "change": {
      "id": "HG-0027",
      "title": "Прямые инструкции навыков и безопасное обновление",
      "tags": [
        "documentation",
        "installation"
      ],
      "goal": "Доставлять основную инструкцию непосредственно в навыке и безопасно обновлять принадлежащие High Grade файлы.",
      "rationale": "Убрать обязательное чтение второй копии процедуры и устаревшие описания без перезаписи пользовательских правок.",
      "scope": "kit/skills, генерация навыков из единственного источника procedures, global-update/recover и контрактные тесты; без изменения проектного каталога.",
      "questions": [],
      "depends_on": [
        {
          "id": "HG-0026",
          "reason": "Использует сокращённые правила и матрицу проверок"
        }
      ],
      "operations": [
        {
          "action": "modify",
          "requirement": {
            "id": "HG-0010-R1",
            "title": "Самостоятельный установленный контекст",
            "statement": "Поставка содержит общие правила, процедуры и справочники и работает без исходного репозитория. SKILL.md содержит основную инструкцию этапа; procedures остаётся единственным редактируемым источником этой инструкции, генератор проверяет соответствие. Навык не требует повторного чтения своей процедуры. Ссылки материалов разрешаются внутри установленного выпуска; шаблоны адресуют проект. Обновление принадлежащих Поставке навыков допускается только после проверки их текущих хешей по активному журналу; пользовательские изменения не перезаписываются. Preview ничего не переключает. Ошибка применения восстанавливает прежние навыки; прерывание сохраняет проверяемую запись для явного восстановления, не объявляется успешной установкой.",
            "scenarios": [
              {
                "id": "HG-0010-S1",
                "given": "Временная фикстура теста tests/global_contracts.rs::installed_runtime_references_survive_removal_of_source_copy создана с исходными данными указанного случая",
                "when": "пакет установлен в отдельный профиль и исходная копия пакета удалена",
                "then": "все материалы манифеста и локальные Markdown-ссылки установленного выпуска доступны, а global-status подтверждает установку",
                "verification": "Запустить cargo test --locked --test global_contracts installed_runtime_references_survive_removal_of_source_copy -- --exact; проверить фактические утверждения о результате и границах сценария"
              },
              {
                "id": "HG-0027-S1",
                "given": "Принадлежащие выпуску навыки отличаются от нового кандидата; отдельно имеется пользовательская правка",
                "when": "Выполнить preview и update в штатной и конфликтной фикстуре",
                "then": "Штатное обновление меняет навыки вместе с выпуском; пользовательская правка отвергает обновление и сохраняется.",
                "verification": "Контрактные тесты global_contracts: обновление принадлежащего навыка и сохранность изменённого пользователем."
              },
              {
                "id": "HG-0027-S2",
                "given": "Переключение набора навыков прервано или завершается ошибкой",
                "when": "Восстановить операцию по сохранённому журналу",
                "then": "Прежний набор восстановлен при старом активном указателе; сторонние изменения не перезаписаны, неизвестное состояние не объявлено успехом.",
                "verification": "Детерминированные фикстуры незавершённой транзакции и ошибки применения в global_contracts."
              },
              {
                "id": "HG-0027-S3",
                "given": "Процедуры являются редактируемым источником, установлена Поставка",
                "when": "Сверить генерацию и прочитать установленный SKILL.md без исходного репозитория",
                "then": "Навык содержит основную инструкцию и точное разрешение путей активного выпуска; повторное чтение той же процедуры не требуется.",
                "verification": "Проверка генератора --check и контрактный тест установленного навыка."
              }
            ]
          }
        }
      ],
