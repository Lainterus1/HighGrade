  "findings": [
    {
      "id": "C-PRESERVE-1",
      "priority": 1,
      "kind": "source_defect",
      "path": "src/package.rs",
      "lines": [
        477,
        480
      ],
      "finding": "Unix replace_active uses fs::write on deterministic dest.with_extension(next), without no-clobber/temp symlink rejection; pre-existing foreign file overwritten, symlink referent can be outside profile. Global pointer/router updates and recovery call it.",
      "evidence": "Source read; global_contracts pointer blocker is a directory on non-Windows, so it does not cover regular file/symlink.",
      "required_resolution": "Isolated real update proof + no-clobber safe temp publication + regression exact sentinel/pointer/routers preservation; independent final diff/results review.",
      "execution_confirmed": false
    },
    {
      "id": "C-INPUTS-1",
      "priority": 2,
      "kind": "causal_metadata_gap",
      "finding": "Check capture adds declared/check/shared/relative program/runners.json, not Rust/module/fixture/manifest dependency closure. HG12/HG13 and expanded legacy global/bootstrap checks often declare only Cargo/test.",
      "proposal": "catalog-check-input-proposals.json: 28 primary +24 expanded exact per-check additive proposals.",
      "execution_confirmed": false
    },
    {
      "id": "C-ASSERT-1",
      "priority": 2,
      "kind": "observation_gap",
      "path": "tests/catalog_contracts.rs",
      "function": "action_diagnostics_check_runner_without_execution",
      "finding": "Store SHA alone cannot prove runner was not executed. Actual source does not execute, but a mutant executing harmless runner can survive.",
      "required_resolution": "Runner writes marker on execution; diagnostic call must leave marker absent and preserve store."
    },
    {
      "id": "C-ASSERT-2",
      "priority": 2,
      "kind": "observation_gap",
      "path": "tests/spec_contracts.rs",
      "function": "reviewed_contract_transfer_preserves_unverified_status_and_rejects_bad_inputs",
      "finding": "Whole-store bytes not compared at each origin/stale/mixed/ID refusal. Refusal code alone cannot prove no write.",
      "required_resolution": "Capture/comparison after every refusal; mutation write-then-refuse must fail substantive assertion."
    },
    {
      "id": "C-METHOD-1",
      "priority": 2,
      "kind": "required_method_open",
      "requirement": "HG-0037-R1",
      "finding": "Read assertions prove selected output and local CAS, not comparable performance measurements required by statement.",
      "required_resolution": "Bounded comparable measurement with explicit fixture/workload/model/environment; no net benefit claim if unavailable."
    },
    {
      "id": "C-NORM-1",
      "priority": 2,
      "kind": "pending_conflict_resolved",
      "requirement": "HG-0063-R1",
      "finding": "Historical pending export required immutable external ID; current spec now correctly makes external Git/build/artifact ID optional and exact change/input readiness mandatory.",
      "current_sha256": "e6da02371361c4bfc39273118f373e01b5e91b5c38341962f356dd46472e205c",
      "scenarios": [
        "HG-0063-S4",
        "HG-0063-S5"
      ],
      "execution_confirmed": false
    },
    {
      "id": "C-COVERAGE-1",
      "priority": 3,
      "kind": "denominator_limit",
      "finding": "35 of56 selected scenarios have no declared checks in original export. Many have real annotated tests; absent binding is not absent code/test nor a runtime failure. Manual installed-agent/documentary routes remain distinct."
    },
    {
      "id": "C-ASSERT-3",
      "priority": 3,
      "kind": "boundary_gap",
      "requirement": "HG-0012-R3",
      "finding": "Read CLI test removes external ID/comment for needs_changes, not accepted. Source permits both; accepted-without-ID should be independently guarded against obsolete mandatory-ID mutation."
    }
  ],
  "mutation_proposals": [
    {
      "id": "C-M1",
      "target": "src/package.rs::replace_active + global update temp path",
      "owner": "General preservation; global/update current contract reviewed by parent",
      "precondition": "Own disposable profile/candidate, successful control update; precreate regular-file and symlink temp blockers separately.",
      "mutation": "Replace new safe no-clobber temp guard with historical write/truncate behavior after fix.",
      "expected": "Refuse activation, preserve foreign temp/referent, active pointer and routers; mutant must violate byte assertion.",
      "minimal_command": "cargo test --locked --test global_contracts <new_temp_preservation_regression> -- --exact",
      "execution": "not run"
    },
    {
      "id": "C-M2",
      "target": "src/specs.rs::diagnose",
      "owner": "HG-0036-R1 / HG-0036-S3",
      "precondition": "Runner fixture writes an isolated marker if invoked. Baseline marker absent.",
      "mutation": "Invoke selected runner from diagnose while leaving store unchanged.",
      "expected": "Diagnostic may inspect availability but marker stays absent; mutant fails marker assertion.",
      "minimal_command": "cargo test --locked --test catalog_contracts action_diagnostics_check_runner_without_execution -- --exact",
      "execution": "not run"
    },
    {
      "id": "C-M3",
      "target": "src/specs.rs transfer rejection guards",
      "owner": "HG-0008-R1 / HG-0008-S2",
      "precondition": "Own legacy store fixture; snapshot every rejected action before/after.",
      "mutation": "Write catalog or archive before returning one required ImportSourceDrift / stale review / mixed import / ID refusal.",
      "expected": "Each refusal preserves exact prior bytes and history; return finding alone insufficient.",
      "minimal_command": "cargo test --locked --test spec_contracts reviewed_contract_transfer_preserves_unverified_status_and_rejects_bad_inputs -- --exact",
      "execution": "not run"
    },
    {
      "id": "C-M4",
      "target": "src/specs/progress.rs::decide_value / attention",
      "owner": "HG-0012-R3/R5 current optional ID; corrected pending HG63",
      "precondition": "Ready current change and exact snapshots; accepted decision without verified_revision/comment.",
      "mutation": "Reject empty external verified_revision although exact snapshots valid.",
      "expected": "Accepted decision recorded with tool time/author/exact snapshots and unknown external ID; stale/absent snapshot still refuses atomically.",
      "minimal_command": "cargo test --locked --test spec_contracts <accepted_optional_external_id_regression> -- --exact",
      "execution": "not run"
    },
    {
      "id": "C-M5",
      "target": "src/specs/storage.rs::recover",
      "owner": "HG-0002-R2 / HG-0013-R2",
      "precondition": "Two journal targets, first valid unapplied and later externally changed; owned fixture.",
      "mutation": "Interleave validation and write targets, so first changes before late conflict.",
      "expected": "Whole set and journal unchanged on refusal.",
      "minimal_command": "cargo test --locked --test catalog_contracts recovery_conflict_preserves_all_targets_and_the_observed_journal -- --exact",
      "execution": "not run"
    },
    {
      "id": "C-M6",
      "target": "src/specs.rs scoped baseline capture",
      "owner": "HG-0039-R1",
      "precondition": "Capture original target, remove/re-add operation while outside target changes.",
      "mutation": "Refresh original baseline when operations are re-added.",
      "expected": "Original capture retained and drift rejects integration; no current data overwritten.",
      "minimal_command": "cargo test --locked --test catalog_contracts scoped_baseline_captures_only_selected_requirements_and_never_refreshes -- --exact",
      "execution": "not run"
    }
  ],
  "pending_operations_review": {
    "original_export_sha256": "95c35d9641435936e57374082584127fe23d87793a98c2275ad9d9b0215d4fae",
    "read_indices": [
      7,
      8,
      10,
      11,
      15,
      16,
      17
    ],
    "current_HG63_requirement": {
      "id": "HG-0063-R1",
      "title": "Переносимый проектный маршрут и нормативная матрица",
      "statement": "Поставка SHALL хранить общие границы Work, Commit, Push и приёмки отдельно от конкретного runbook. Init SHALL использовать существующие проектные источники, не спрашивать известное повторно и сохранять минимальную адаптацию у проектного владельца: применимость Git; remote и целевую ветку; base и обязательность PR; pre-submit и обязательные критерии готовности, отдельный статус CI и лишь явно назначенное условие ожидания; условия и права человеческой приёмки, merge, release и deploy; назначение местной активации и восстановления; внешние последствия отправки; способ идентифицировать проверенный результат, включая squash/rebase. Release ID, build-release и global-update принадлежат только проектам, которые их назначают. Для проекта без Git SHALL поддерживаться неизменяемый проектный результат либо завершение Work без коммита. При неполной старой адаптации SHALL показываться конкретный upgrade gap, ограничивающий зависимое действие, без молчаливой перезаписи чужих правил. Нормативная таблица SHALL охватывать solo Git, PR+remote CI, autodeploy, no-Git, native-приёмку и преобразование истории; смысловая/структурная проверка этой таблицы SHALL NOT объявляться фактическим исполнением агентом. Native-приёмка требует текущей технической готовности и точных отпечатков предъявленного change и причинных входов. Внешний Git SHA/build/artifact ID необязателен; его отсутствие не требует нового коммита или сборки ради формы.",
      "scenarios": [
        {
          "id": "HG-0063-S1",
          "given": "Solo Git проект не назначает локальную активацию и release ID; известны состав задачи, проверки и разрешение на локальную фиксацию",
          "when": "Разобрать маршрут Work→Commit по проектному шаблону",
          "then": "Создаётся точный локальный кандидат после pre-submit проверок; финальные local gates определены проектом. Не навязываются сборка выпуска, повышение версии, активация, push, PR или приёмка; их отсутствие не блокирует коммит",
          "verification": "Смысловая сверка нормативного содержания и воспроизводимая таблица решений по указанным исходным условиям; проверить ссылки и согласованность процедуры с шаблоном. Это не агентный пилот, не исполнение Git/CI и не подтверждение поведения будущего агента."
        },
        {
          "id": "HG-0063-S2",
          "given": "Проект требует feature-ветку, PR в заданную base и запуск remote CI после push/PR; отдельного условия ожидания нет. Публикация и PR разрешены, merge не разрешён.",
          "when": "Разобрать таблицу переходов при pending, success, failure и unavailable remote CI",
          "then": "Разрешены Commit и отправка/PR после pre-submit барьеров. Pending/unavailable CI сообщаются отдельно и не блокируют готовность или порученную активацию. Известный failure разбирается; выявленная ошибка возвращается в Work, новый состав проходит затронутые проверки. Success доказывает лишь соответствующий точный SHA; приёмка, merge и deploy не выводятся автоматически. Явный отдельный барьер ожидания сохраняется, если его назначил проект или пользователь.",
