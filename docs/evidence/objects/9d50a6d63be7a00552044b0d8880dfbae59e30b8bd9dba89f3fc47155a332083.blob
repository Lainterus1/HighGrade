from pathlib import Path
from datetime import datetime,timezone
import json,subprocess,importlib.util
root=Path.cwd();local=root/'.highgrade/local/project-refresh-2026-10-14';cli=str(root/'target/debug/highgrade')
spec=importlib.util.spec_from_file_location('storage',root/'scripts/evidence_store.py');storage=importlib.util.module_from_spec(spec);spec.loader.exec_module(storage)
# Preserve original browser and Python machine streams once. Keep native JUnit's
# existing object rather than introducing a second copy.
sources=[str((local/name).relative_to(root)) for name in ['python-final-with-archive.json','node-guards-node24.json','browser-final-permitted.json','installed-current-fixture.json']]
sources+=['target/highgrade/runs/clear-ui-21e320bb223b47e6b944d4a0805c76b9/playwright/report.json','target/highgrade/runs/clear-installed-5203abae4b38417099027aa841cefbcb/playwright/report.json']
manifest=storage.export(root,sources,{'purpose':'Current local Python, Node and browser checks for selected existing scenarios','outcome':'passed','limits':'Installed assertions used authentic ea6d14a/0.4.0 and fda4117/0.3.4. This does not claim an exact-SHA release of the dirty working tree or Windows CI.'})
objects={e['source']:e['path'] for e in storage.verify(root,manifest)['files']}
now=datetime.now(timezone.utc).isoformat();batch=[]
def add(ident,scenario,report,inputs,observation,command):
 assert all((root/p).is_file() for p in inputs),(ident,scenario,[p for p in inputs if not (root/p).is_file()])
 batch.append({'id':ident,'evidence':{'scenario':scenario,'method':'native_report','command':command,'captured_at':now,'outcome':'passed','observation':observation,'inputs':sorted(set(inputs)),'report':report}})
# The current selected full-run/fixture lifetime check is automatic, despite the
# historical null runner. Do not call it human observation or acceptance.
c2=next(c for c in json.loads((root/'specs/changes/HG-0024/spec.json').read_text())['checks'] if c['id']=='HG-0024-C2')
junit=json.loads((local/'native-export.json').read_text())['junit']
add('HG-0024','HG-0024-S4',junit,c2['inputs']+['tests/support/mod.rs','src/lib.rs','Cargo.toml','Cargo.lock','rust-toolchain.toml','.config/nextest.toml'],
 '237 actual Nextest cases passed without skips. test_dir_cleans_after_panic_and_keeps_foreign_directory asserted removal of its exact owned directory after caught panic and retention of the separate foreign directory. No global temporary-directory census or deletion of unknown data is claimed.',
 'cargo nextest run --locked --profile highgrade')
ui_inputs=['ui/src/api/client.ts','ui/src/features/specs/decisionDrafts.ts','ui/src/features/specs/DecisionDialog.tsx','ui/src/features/specs/decisionCopy.ts','ui/src/features/specs/DecisionReason.tsx','ui/src/features/specs/ResultStatusSelect.tsx','ui/src/features/specs/NativeWorkspace.tsx','ui/src/features/specs/NativeDocument.tsx','ui/src/features/specs/SpecEditor.tsx','ui/tests/decision.spec.ts','ui/tests/native-fixture.ts','ui/playwright.config.ts','ui/package.json','ui/package-lock.json','ui/vite.config.ts','src/ui.rs','src/ui/bundle.rs','src/lib.rs','src/paths.rs','src/specs.rs','src/specs/attention.rs','src/specs/cards.rs','src/specs/progress.rs','src/specs/checks.rs','src/specs/storage.rs','src/specs/storage/shared_inputs.rs','Cargo.toml','Cargo.lock','build.rs','rust-toolchain.toml']
ui_report=objects['target/highgrade/runs/clear-ui-21e320bb223b47e6b944d4a0805c76b9/playwright/report.json']
for scenario,observation in [('HG-0061-S1','Real browser Close/Escape/unmount and navigation preserved the same draft, isolated project/spec/request, and sent no POST. Pure identity assertions now require every causal revision to differ.'),('HG-0061-S2','Real lost-unwritten/lost-committed responses, failed GET inspection, pending writes and input drift preserved text/status and blocked automatic retries. Explicit GET and confirmed absence permitted only an explicit submit. api-client StoreBusy POST test asserted one request; GET retry and abort also passed.')]:
 add('HG-0061',scenario,ui_report,ui_inputs+['ui/tests/api-client.spec.ts'],observation+' Actual 41-case Linux browser report: zero skips, failures or flakes; no human acceptance or new release certification.', 'npm --prefix ui test -- native.spec.ts decision.spec.ts edit.spec.ts api-client.spec.ts editorial.spec.ts hg58.spec.ts hg58-keyboard.spec.ts visual.spec.ts --fail-on-flaky-tests')
python_report=objects[str((local/'python-final-with-archive.json').relative_to(root))]
add('HG-0069','HG-0069-S2',python_report,['scripts/evidence_store.py','scripts/tests/test_evidence_store.py'],
 'All 69 script tests passed. Evidence-store tests selected/idempotently exported originals and rejected both changed-length and same-length corruption by SHA256. The previously missed SHA-check removal is detected by the strengthened assertion; original sources remain unchanged.', 'python -B -m unittest discover -s scripts/tests -v')
# The Python lifecycle cases assert preservation/registration/recovery behavior;
# the separate managed-browser report guard observations are retained in the task.
add('HG-0069','HG-0069-S3',python_report,['scripts/evidence_store.py','scripts/target-maintenance.py','scripts/tests/test_evidence_store.py','scripts/tests/test_target_maintenance.py','scripts/tests/test_verify.py','scripts/verify.py'],
 'Real filesystem/owned-run regression cases passed: active/unknown/new or changed scratch survives; corrupt export and interrupted recovery prevent deletion. Current browser guards separately reject foreign token, invalid schema/state/PID, dead owner and linked output without changing protected report bytes. No unknown inherited run was removed.', 'python -B -m unittest discover -s scripts/tests -v')
path=local/'direct-evidence-batch.json';path.write_text(json.dumps(batch,ensure_ascii=False,indent=2)+'\n')
listing=json.loads(subprocess.check_output([cli,'spec-list','--root',str(root)]));expected=next(m['store_sha256'] for m in listing['measurements'] if 'store_sha256' in m)
argv=[cli,'spec-evidence-batch','--root',str(root),'--expected',expected,'--input',str(path.relative_to(root))]
r=subprocess.run(argv,capture_output=True,text=True)
(local/'direct-evidence-receipt.json').write_text(json.dumps({'argv':argv,'exit_code':r.returncode,'stdout':r.stdout,'stderr':r.stderr,'manifest':manifest},ensure_ascii=False,indent=2)+'\n')
print('Direct evidence records:',len(batch),'exit',r.returncode);assert r.returncode==0,r.stdout+r.stderr
