    {
      "change": {
        "id": "HG-0024",
        "title": "Честный учёт проверок и ресурсов тестов",
        "tags": [
          "verification"
        ],
        "goal": "Показывать точный охват автоматических проверок и выполнять проектные Rust-тесты без накопления временных файлов и лишних повторов.",
        "rationale": "Текущий trace называет отсутствие автоматической связи ScenarioUnconfirmed даже при отдельном доказательстве; счётчики тестов и сценариев смешиваются. Прогон оставляет около 130 МиБ временных файлов; устаревшие результаты требуют адресного разбора.",
        "scope": "Отчёты trace и проектной сверки сценариев, тестовые временные фикстуры и документация запуска. Сохранить независимые ручные доказательства, прежние контракты и исторические результаты.",
        "questions": [],
        "operations": [
          {
            "action": "add",
            "requirement": {
              "id": "HG-0024-R1",
              "title": "Явная область отчёта о проверках",
              "statement": "Отчёт автоматической трассировки SHALL раздельно показывать число случаев в исходном отчёте, отдельно число реально выполненных, пропущенных и неизвестных среди записанных в отчёте тестов, а также число отсутствующих результатов при наличии инвентаря (иначе неизвестно), число уникальных тестов с привязкой и результат связанных сценариев. Сценарий без автоматической связи SHALL обозначаться как находящийся вне области этого отчёта; его ручное или внешнее доказательство не SHALL выводиться из трассировки. Сбой, пропуск, неизвестный или устаревший результат связанного теста SHALL оставаться неподтверждённым. Чтение отчёта SHALL не запускать тесты и не менять каталог.",
              "scenarios": [
                {
                  "id": "HG-0024-S1",
                  "given": "Набор содержит несколько тестов, одну связь с несколькими сценариями и тесты без сценарной метки",
                  "when": "Построить отчёт после фактического запуска",
                  "then": "Отдельные счётчики случаев в отчёте, выполненных, пропущенных, неизвестных и отсутствующих тестов, уникальных связанных тестов и сценариев точны и не трактуются как один знаменатель",
                  "verification": "Rust-тест trace на изолированном отчёте Nextest и проверка проектной сводки по настоящему прогону"
                },
                {
                  "id": "HG-0024-S2",
                  "given": "В каталоге есть сценарий с ручной проверкой или отдельным внешним доказательством без автоматической связи",
                  "when": "Прочитать автоматическую трассировку",
                  "then": "Сценарий явно находится вне автоматической области; отчёт не называет его проваленным или проверенным и не подменяет отдельное доказательство",
                  "verification": "Rust-тест trace с несвязанным сценарием и сохранённым отдельным доказательством"
                },
                {
                  "id": "HG-0024-S3",
                  "given": "Связанный тест завершился ошибкой, пропущен либо исходный отчёт устарел",
                  "when": "Прочитать трассировку",
                  "then": "Связанный сценарий не получает PASS; причина остаётся различимой, а другие результаты не скрывают сбой",
                  "verification": "Rust-тесты trace для failed, skipped и stale по настоящей структуре отчёта"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0024-R2",
              "title": "Ограниченный жизненный цикл тестовых файлов",
              "statement": "Проектные Rust-тесты SHALL изолировать временные каталоги и освобождать собственные результаты после завершения, включая ошибочный тест, без удаления чужих файлов. Очистка ранее накопленных каталогов SHALL предваряться проверкой точного расположения и владения; сомнительные данные сохраняются.",
              "scenarios": [
                {
                  "id": "HG-0024-S4",
                  "given": "Тест создаёт изолированный временный профиль и завершается успешно либо с ошибкой",
                  "when": "Завершить тестовый процесс",
                  "then": "Собственный временный профиль удалён, а посторонний каталог и диагностика исхода не затронуты",
                  "verification": "Регрессионный тест фикстуры и сравнение созданных тестовых каталогов до и после полного Nextest-прогона"
                }
              ]
            }
          }
        ],
        "tasks": [
          {
            "id": "HG-0024-T1",
            "description": "Сделать честные раздельные статусы trace и проектной сводки; сверить 10 сценариев без check и 74 теста без метки, не добавляя фиктивных связей.",
            "done": true
          },
          {
            "id": "HG-0024-T2",
            "description": "Устранить утечки временных фикстур в тестах, сохранить диагностику и убрать зависимость текущих ожиданий от жёстко заданного номера выпуска.",
            "done": true
          },
          {
            "id": "HG-0024-T3",
            "description": "Классифицировать устаревшие доказательства, измерить время и прирост диска; безопасно разобрать ранее накопленные test-owned каталоги после preview.",
            "done": true
          },
          {
            "id": "HG-0024-T4",
            "description": "Выполнить адресные и полные проверки, записать доказательства, пройти независимое ревью и подготовить локальное принятие.",
            "done": true
          }
        ],
