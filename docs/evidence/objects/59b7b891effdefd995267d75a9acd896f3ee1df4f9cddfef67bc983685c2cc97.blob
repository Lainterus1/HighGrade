      "change": {
        "id": "HG-0012",
        "title": "Нумерация, прогресс и решение человека",
        "tags": [
          "specifications",
          "workflow"
        ],
        "goal": "Действующие требования области «Нумерация, прогресс и решение человека» доступны в самостоятельном нативном формате с конкретными сценариями и честным статусом проверки",
        "rationale": "Актуализация действующего контракта по аудиту завершённых правил; отсутствие проверки не считается успехом",
        "scope": "Действующее поведение области «Нумерация, прогресс и решение человека»; старые источники и решения остаются только в архиве",
        "questions": [],
        "operations": [
          {
            "action": "add",
            "requirement": {
              "id": "HG-0012-R1",
              "title": "Номер и заголовок",
              "statement": "CLI атомарно назначает следующий HG-номер, created_at и шаблон; title редактируется независимо. Старые ID сохраняются, использованные не переиспользуются.",
              "scenarios": [
                {
                  "id": "HG-0012-S1",
                  "given": "Временная фикстура теста tests/spec_contracts.rs::automatic_numbers_survive_abandon_failure_and_competing_cli_writers создана с исходными данными указанного случая",
                  "when": "Создать изменения, одновременно повторить создание от одного снимка и вызвать сбой записи",
                  "then": "Успешные создания имеют разные последовательные ID; конфликт/сбой сохраняет целый store и счётчик; отменённый номер не используется вновь",
                  "verification": "Запустить cargo test --locked --test spec_contracts automatic_numbers_survive_abandon_failure_and_competing_cli_writers -- --exact; проверить фактические утверждения о результате и границах сценария"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0012-R2",
              "title": "Совместимость",
              "statement": "Версия 1 читается без записи; явная атомарная миграция сохраняет точную исходную копию, ID, доказательства и историю; неизвестное не выдумывается.",
              "scenarios": [
                {
                  "id": "HG-0012-S2",
                  "given": "Временная фикстура теста tests/spec_contracts.rs::v1_migration_preserves_exact_backup_ids_evidence_and_review_digest создана с исходными данными указанного случая",
                  "when": "Прочитать, попытаться записать без миграции, затем выполнить миграцию и повтор/конфликт",
                  "then": "Чтение не меняет байты; запись требует миграции; резервная копия точна; повтор безопасен; старые данные и валидность ревью сохранены",
                  "verification": "Запустить cargo test --locked --test spec_contracts v1_migration_preserves_exact_backup_ids_evidence_and_review_digest -- --exact; проверить фактические утверждения о результате и границах сценария"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0012-R3",
              "title": "Человеческое решение",
              "statement": "Приёмка записывается только после явного решения человека с автором, временем инструмента, редакцией спецификации и реализации. История неизменяема через spec-save; доработка требует комментария.",
              "scenarios": [
                {
                  "id": "HG-0012-S3",
                  "given": "Временная фикстура теста tests/spec_contracts.rs::human_history_is_atomic_protected_and_bound_to_spec_and_implementation создана с исходными данными указанного случая",
                  "when": "Записать решение, попробовать неполные/устаревшие/поддельные входы и затем изменить контракт или проверенный код",
                  "then": "Полная запись сохраняется, неверные не меняют store; история остаётся, новая версия не наследует принятие",
                  "verification": "Запустить cargo test --locked --test spec_contracts human_history_is_atomic_protected_and_bound_to_spec_and_implementation -- --exact; проверить фактические утверждения о результате и границах сценария"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0012-R4",
              "title": "Прогресс JSON",
              "statement": "spec-list вычисляет готовность из задач, сценариев, доказательств и ревью; человеческая приёмка и техническая готовность различаются. Сводка JSON содержит количества без процентов.",
              "scenarios": [
                {
                  "id": "HG-0012-S4",
                  "given": "Временная фикстура теста tests/spec_contracts.rs::json_progress_rejects_missing_skipped_unknown_and_negative_review создана с исходными данными указанного случая",
                  "when": "Запросить список до и после изменений и удаления отчёта",
                  "then": "ID/title и счётчики верны; failed/skipped/unknown/stale/no_go не дают ready; отсутствие решения pending; включение не означает принятие",
                  "verification": "Запустить cargo test --locked --test spec_contracts json_progress_rejects_missing_skipped_unknown_and_negative_review -- --exact; проверить фактические утверждения о результате и границах сценария"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0012-R5",
              "title": "Пакетная проверка и передача",
              "statement": "Явно выбранный пакет решений привязан к каждой версии и записывается целиком либо отклоняется. Work передаёт человеку ID/title, проверенную версию, краткие действия/ожидания и ограничения; не принимает за него.",
              "scenarios": [
                {
                  "id": "HG-0012-S5",
                  "given": "Временная фикстура теста tests/spec_contracts.rs::isolated_three_spec_lifecycle_keeps_exact_decisions_and_pending_work создана с исходными данными указанного случая",
                  "when": "Принять две, вернуть одну, изменить и проверить последнюю, записать новое решение",
                  "then": "История и JSON-сводка показывают точные решения по версиям; неверный элемент пакета не записывает остальные; процедуры сохраняют отдельные полномочия",
                  "verification": "Запустить cargo test --locked --test spec_contracts isolated_three_spec_lifecycle_keeps_exact_decisions_and_pending_work -- --exact; проверить фактические утверждения о результате и границах сценария"
