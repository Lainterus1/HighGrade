    {
      "change": {
        "id": "HG-0013",
        "title": "Структурированные спецификации",
        "tags": [
          "specifications"
        ],
        "goal": "Действующие требования области «Структурированные спецификации» доступны в самостоятельном нативном формате с конкретными сценариями и честным статусом проверки",
        "rationale": "Актуализация действующего контракта по аудиту завершённых правил; отсутствие проверки не считается успехом",
        "scope": "Действующее поведение области «Структурированные спецификации»; старые источники и решения остаются только в архиве",
        "questions": [],
        "operations": [
          {
            "action": "add",
            "requirement": {
              "id": "HG-0013-R1",
              "title": "Формат и черновик",
              "statement": "Инструмент SHALL создавать JSON-заготовку с версией формата и устойчивыми ID; структурная схема SHALL иметь один источник с типами инструмента. Пустое содержание SHALL оставаться черновиком, неизвестные версии/поля SHALL отвергаться без записи.",
              "scenarios": [
                {
                  "id": "HG-0013-S1",
                  "given": "Временная фикстура теста tests/spec_contracts.rs::drafts_are_readable_but_unknown_versions_and_fields_never_write создана с исходными данными указанного случая",
                  "when": "создана заготовка либо передан документ с неизвестной схемой/полем",
                  "then": "заготовка читается и показывает незавершённость, неподдерживаемое отклоняется без повреждения сохранённого документа",
                  "verification": "Запустить cargo test --locked --test spec_contracts drafts_are_readable_but_unknown_versions_and_fields_never_write -- --exact; проверить фактические утверждения о результате и границах сценария"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0013-R2",
              "title": "Сохранность и конфликты",
              "statement": "Сохранение SHALL проверять ожидаемый хеш под блокировкой и атомарно заменять документ; конфликт или сбой SHALL сохранять прежний полный документ. Включение изменения SHALL проверять исходные редакции затронутых требований, выполнять явные add/modify/remove и сохранять историю вместе с новым действующим состоянием.",
              "scenarios": [
                {
                  "id": "HG-0013-S2",
                  "given": "Временная фикстура теста tests/spec_contracts.rs::competing_processes_and_failed_replace_preserve_whole_store создана с исходными данными указанного случая",
                  "when": "два писателя сохраняют от одного хеша либо запись прерывается до замены",
                  "then": "не теряются изменения, сохраняется полный старый либо новый документ, конфликт сообщается явно",
                  "verification": "Запустить cargo test --locked --test spec_contracts competing_processes_and_failed_replace_preserve_whole_store -- --exact; проверить фактические утверждения о результате и границах сценария"
                },
                {
                  "id": "HG-0013-S3",
                  "given": "Временная фикстура теста tests/spec_contracts.rs::integration_rejects_stale_base_and_requires_removal_reason создана с исходными данными указанного случая",
                  "when": "подготовлено изменение существующего требования или удаление с причиной, но действующая редакция уже изменилась",
                  "then": "включение отклоняется; на актуальной базе изменение включается вместе с архивной записью, отсутствующая причина удаления не проходит",
                  "verification": "Запустить cargo test --locked --test spec_contracts integration_rejects_stale_base_and_requires_removal_reason -- --exact; проверить фактические утверждения о результате и границах сценария"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0013-R3",
              "title": "Доказательства и дрейф",
              "statement": "Доказательство SHALL ссылаться на сценарий, его редакцию, требование и значимые входы/отчёт. Изменение связанного содержания, входов или отчёта SHALL требовать пересмотра; skipped/failed/unknown SHALL не закрывать сценарий. Неизменённые независимые доказательства SHALL переиспользоваться. Структурная валидность SHALL не означать смысловую готовность, приёмку или достоверность утверждений автора записи.",
              "scenarios": [
                {
                  "id": "HG-0013-S4",
                  "given": "Временная фикстура теста tests/spec_contracts.rs::evidence_and_review_go_stale_without_losing_unaffected_observations создана с исходными данными указанного случая",
                  "when": "связанный сценарий/код/отчёт изменён либо результат skipped",
                  "then": "завершение блокируется, а незатронутое доказательство сохраняет актуальность",
                  "verification": "Запустить cargo test --locked --test spec_contracts evidence_and_review_go_stale_without_losing_unaffected_observations -- --exact; проверить фактические утверждения о результате и границах сценария"
                }
              ]
            }
          },
          {
            "action": "add",
            "requirement": {
              "id": "HG-0013-R4",
              "title": "Полный самостоятельный маршрут",
              "statement": "Новая задача SHALL проходить через установленный инструмент и навыки без внешнего инструмента спецификаций: от цели и заготовки до реального теста, ревью, продолжения и включения требований. Команды SHALL возвращать выборочные данные и понятные ошибки. Спецификация SHALL описывать исходное состояние, действие, наблюдаемые результаты и воспроизводимую проверку, без обязательного исполняемого GWT.",
              "scenarios": [
                {
                  "id": "HG-0013-S5",
                  "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: отдельный агент получает установленную Поставку, проект, разрешённую задачу и сохранённое незавершённое изменение",
                  "when": "Продолжить разрешённую задачу через установленную Поставку и проверить результат",
                  "then": "он находит следующий шаг, сохраняет решения, выполняет настоящую проверку поведения и заканчивает разрешённый scope без исходников High Grade и внешнего инструмента спецификаций",
                  "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
                }
              ]
            }
          }
        ],
