            "given": "Техническая правка затрагивает сохранность данных без изменения контракта",
            "when": "Выполнить задачу",
            "then": "Проведены регрессия и независимое ревью без искусственной новой спеки",
            "verification": "Изолированное упражнение агента: исходные файлы, фактические действия, итоговые артефакты и тесты; независимое ревью"
          },
          {
            "id": "HG-0006-S7",
            "given": "Изолированный подключённый проект и только файлы Поставки",
            "when": "Завершить техническую задачу без spec ID",
            "then": "Переданы результат, проверки и ограничения; commit применим без ID, публикация и приёмка не выдуманы",
            "verification": "Изолированное упражнение агента: исходные файлы, фактические действия, итоговые артефакты и тесты; независимое ревью"
          }
        ]
      }
    },
    {
      "action": "modify",
      "requirement": {
        "id": "HG-0010-R3",
        "title": "Проектная активация",
        "statement": "Commit SHALL выполнять активацию только когда она назначена проектом и разрешена. Проверка и восстановление SHALL следовать фактическому механизму проекта; автоматический откат SHALL не обещаться для произвольной команды.",
        "scenarios": [
          {
            "id": "HG-0010-S5",
            "given": "В изолированном временном проекте сохранены исходные файлы, версия Поставки и разрешение; исходное условие: активация неприменима либо назначенная команда завершилась ошибкой",
            "when": "Выполнить highgrade-commit с заданной проектом активацией",
            "then": "агент соответственно завершает локальным коммитом либо сообщает отдельно коммит, ошибку и установленное состояние восстановления, не запуская global-update по предположению",
            "verification": "Локальное упражнение: сохранить входной снимок, журнал фактических действий, diff и наблюдаемый исход; до исполнения оставить неподтверждённым"
          }
        ]
      }
    }
  ]
