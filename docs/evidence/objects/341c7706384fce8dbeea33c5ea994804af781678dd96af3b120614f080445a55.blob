  "operation": "spec-run",
  "result": {
    "change": {
      "id": "HG-0018",
      "title": "Имя High Grade и независимое ревью субагентом",
      "tags": [
        "verification",
        "workflow"
      ],
      "goal": "Действующая Поставка использует имя High Grade и локальное независимое ревью субагентом.",
      "rationale": "Прежняя рабочая совместимость и внешний путь ревью больше не соответствуют выбранному маршруту Поставки.",
      "scope": "Действующий CLI inspect, общие правила и процедура work, инструкция Проекта и проверки. Архивы и исторические отчёты сохраняются; коммит и публикация не входят.",
      "questions": [],
      "operations": [
        {
          "action": "add",
          "requirement": {
            "id": "HG-0018-R1",
            "title": "Ревью значимых изменений субагентом",
            "statement": "Когда действующие правила задачи требуют независимого ревью, исполнитель SHALL поручить отдельному субагенту проверку точных требований, относящегося к задаче diff и исходных результатов. Проверяющий SHALL вернуть GO или NO_GO с конкретными замечаниями и пробелами; существенные исправления SHALL пройти повторное ревью. Недоступное обязательное ревью SHALL оставаться незавершённым.",
            "scenarios": [
              {
                "id": "HG-0018-S1",
                "given": "Значимая правка правил Поставки завершена; сохранены требования, полный diff и исходные отчёты",
                "when": "Исполнитель передаёт их отдельному субагенту",
                "then": "Субагент проверяет сценарии, риски и доказательства, возвращает GO или NO_GO с замечаниями; после исправлений проверяет новую редакцию",
                "verification": "Локально провести ревью этой задачи отдельным субагентом и сохранить его входы, вердикт и повторную проверку"
              }
            ]
          }
        },
        {
          "action": "add",
          "requirement": {
            "id": "HG-0018-R2",
            "title": "Единственный действующий каталог проекта",
            "statement": "При поиске реестра проекта без явного --registry команда inspect SHALL использовать только .highgrade/project/documents.json. Прежний каталог SHALL не служить вторым значением по умолчанию и не исключаться из структурного обзора только из-за старого имени; явный --registry REL SHALL сохранять возможность проверить выбранный пользователем путь.",
            "scenarios": [
              {
                "id": "HG-0018-S3",
                "given": "В проекте есть действующий реестр .highgrade/project/documents.json и отдельный каталог старого формата",
                "when": "Запустить inspect без --registry",
                "then": "Команда выбирает реестр High Grade без неоднозначности, а посторонний каталог не скрывается автоматически",
                "verification": "Запустить cargo test --locked --test contracts default_inspect_uses_only_highgrade_registry -- --exact и проверить выбранный путь и обнаружение постороннего каталога"
              },
              {
                "id": "HG-0018-S4",
                "given": "В проекте нет .highgrade/project/documents.json, но существует сторонний каталог с реестром",
                "when": "Запустить inspect без --registry",
                "then": "Команда сообщает об отсутствии стандартного реестра, не выбирая сторонний каталог",
                "verification": "Запустить cargo test --locked --test contracts default_inspect_uses_only_highgrade_registry -- --exact и проверить отказ до явного выбора"
              }
            ]
          }
        }
      ],
