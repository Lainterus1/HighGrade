+{
+  "tags": [
+    "library"
+  ],
+  "goal": "Один пользователь добавляет название и автора прочитанной книги и видит локальный список.",
+  "rationale": "Synthetic fixture owner задал первый полезный результат; текущий init только подготавливает требования.",
+  "scope": "Первая версия: добавление и просмотр, без сети, аккаунтов и внешних интеграций. Реализация и выбор стека не входят в init; будущие области кода и тестов ещё не назначены.",
+  "questions": [
+    "Какой локальный интерфейс нужен и как запускать его на выбранной среде?",
+    "Должны ли данные сохраняться между запусками и где храниться?",
+    "Какие стек, путь реализации и штатный runner выбрать перед Work?"
+  ],
+  "operations": [
+    {
+      "action": "add",
+      "requirement": {
+        "id": "HG-0001-R1",
+        "title": "Добавление и просмотр книг",
+        "statement": "Первый полезный результат SHALL позволять одному пользователю добавить название и автора прочитанной книги и увидеть их в локальном списке, без сети и аккаунтов.",
+        "scenarios": [
+          {
+            "id": "HG-0001-S1",
+            "given": "Локальный каталог открыт одним пользователем; список пуст. Конкретный интерфейс и хранение уточняются до реализации.",
+            "when": "Пользователь добавляет книгу с названием «Маяк» и автором «Н. Петров».",
+            "then": "В списке видны введённые название и автор; действие не требует сети или аккаунта.",
+            "verification": "До Work выбрать фактический интерфейс и штатный runner; будущая проверка выполняет добавление и наблюдает список и отсутствие сетевой зависимости. В init этот сценарий не исполнялся."
+          }
+        ]
+      }
+    }
+  ],
+  "tasks": [
+    {
+      "id": "HG-0001-T1",
+      "description": "Уточнить локальный интерфейс, хранение и runner в этом же ID до реализации.",
+      "done": false
+    },
+    {
+      "id": "HG-0001-T2",
+      "description": "После отдельного поручения реализовать добавление названия/автора и просмотр локального списка.",
+      "done": false
+    },
+    {
+      "id": "HG-0001-T3",
+      "description": "Проверить добавление и просмотр выбранным штатным способом без сетевой зависимости.",
+      "done": false
+    }
+  ]
+}
