{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "exit_code",
    "command",
    "run_context",
    "config",
    "auto_configs",
    "policy_sha256",
    "artifact_sha256",
    "data_sha256",
    "sources_before",
    "sources_after",
    "changed_paths",
    "project_runtime"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "VERIFIED"
    },
    "exit_code": {
      "const": 0,
      "type": "integer"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "run_context": {
      "type": "string",
      "pattern": "^code-health-audit:[a-f0-9]{32}$"
    },
    "config": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "auto_configs": {
      "type": "object",
      "required": [
        ".coveragerc",
        "pyproject.toml",
        "setup.cfg",
        "tox.ini"
      ],
      "properties": {
        ".coveragerc": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "pyproject.toml": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "setup.cfg": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "tox.ini": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources_before": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "sources_after": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "changed_paths": {
      "const": []
    },
    "project_runtime": {
      "type": "object",
      "required": [
        "python",
        "implementation",
        "system",
        "machine",
        "coverage"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
