{
  "id": "HG-0030",
  "title": "Компактное чтение и редактирование спецификаций",
  "tags": [
    "specifications"
  ],
  "goal": "Сократить объём чтения и механические действия при работе с нативными спеками.",
  "rationale": "Не переносить историю и защищённые поля в каждый цикл редактирования; переиспользовать общие входы проверок.",
  "scope": "CLI spec-read/edit/integrate, shared_inputs, справочник и контрактные тесты; без второго формата спецификации.",
  "questions": [],
  "depends_on": [
    {
      "id": "HG-0029",
      "reason": "Использует разделение контракта и результатов"
    }
  ],
  "related_to": [],
  "operations": [
    {
      "action": "add",
      "requirement": {
        "id": "HG-0030-R1",
        "title": "Достаточный интерфейс работы со спецификациями",
        "statement": "spec-read предоставляет full, summary, editable и requirements; редактируемое представление не содержит истории и защищённых полей. Выборка требований по тегу строится по явным связям изменений и не гарантирует полноту домена. spec-edit с CAS применяет только разрешённые поля; опциональная проверка полноты выполняется до записи и при ошибке сохраняет прежний каталог. spec-integrate уже объединяет проверку готовности и включение; brief возвращает компактный результат. shared_inputs изменения дополняют inputs каждой проверки, их состав и содержимое участвуют в актуальности. Чтение и редактирование не запускают тесты и не записывают приёмку.",
        "scenarios": [
          {
            "id": "HG-0030-S1",
            "given": "Каталог содержит историю и проверяемое изменение",
            "when": "Прочитать компактные представления и применить частичный patch",
            "then": "История не дублируется, защищённые поля и устаревший CAS отвергаются, неверная полная проверка не записывает каталог.",
            "verification": "Контрактные тесты spec-read/edit."
          },
          {
            "id": "HG-0030-S2",
            "given": "Проверка использует shared_inputs",
            "when": "Выполнить проверку и изменить общий вход или его состав",
            "then": "Изменение обнаруживается и результат становится stale; компактная интеграция сохраняет стандартные барьеры.",
            "verification": "Контрактные тесты реального runner и интеграции."
          }
        ]
      }
    }
  ],
